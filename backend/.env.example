DATABASE_URL=postgresql+asyncpg://user:pw@localhost:5432/db
# 生成方式：openssl rand -hex 32；至少 32 字符，change-me 占位值会被拒绝启动
JWT_SECRET=change-me
# 登录 token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 允许的浏览器来源（JSON 数组）
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# —— 对象存储（腾讯云 COS；唯一文件层，无本地后端）——
COS_REGION=ap-beijing
COS_BUCKET=examplebucket-1250000000
COS_SECRET_ID=AKID...
COS_SECRET_KEY=...
# 预签名 URL 有效期（秒）
PRESIGN_EXPIRE_SECONDS=600
# 审核 worker 协程数（同时审核上限）
REVIEW_CONCURRENCY=4
# 上传大小上限（默认 50MB，与引擎硬上限对齐）
UPLOAD_MAX_BYTES=52428800
# worker 空闲轮询间隔（秒）
TASK_POLL_INTERVAL_SECONDS=1.0
# 单任务基础设施异常重试上限
TASK_MAX_ATTEMPTS=3
# 任务卡死判定时长（秒），超过则重置重试
TASK_STALE_SECONDS=600
