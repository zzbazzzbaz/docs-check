# /opt/docx-check/.env 模板（生产服务器本地文件，勿提交；首部署时手工创建）
#
# 后端 Settings 全必填（缺一启动失败，fail-fast）；与 backend/.env.example 对应。
# POSTGRES_* 由 docker-compose.yml 插值使用；DATABASE_URL 是后端连接串（密码保持一致）。

# ===== backend 运行时 =====
DATABASE_URL=postgresql+asyncpg://docx:CHANGE_ME@postgres:5432/docx_check
# 生成方式：openssl rand -hex 32；至少 32 字符，change-me 占位值会被拒绝启动
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["https://docx-check.prod.chatgqt.top","https://admin.docx-check.prod.chatgqt.top"]
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
REVIEW_CONCURRENCY=2
UPLOAD_MAX_BYTES=52428800
TASK_POLL_INTERVAL_SECONDS=1.0
TASK_MAX_ATTEMPTS=3
TASK_STALE_SECONDS=600
COS_REGION=ap-beijing
COS_BUCKET=examplebucket-1250000000
COS_SECRET_ID=CHANGE_ME
COS_SECRET_KEY=CHANGE_ME
PRESIGN_EXPIRE_SECONDS=600

# ===== compose 插值（与 DATABASE_URL 中的密码一致） =====
POSTGRES_PASSWORD=CHANGE_ME
